{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build NestJS project",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			],
			"group": "build"
		},
		{
			"label": "Start database container",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"up",
				"-d",
				"db"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}