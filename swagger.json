  "info": {
    "title": "Ticket Master API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateContactDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Chikondi Banda"
          },
          "email": {
            "type": "string",
            "example": "chikondi@example.com"
          },
          "subject": {
            "type": "string",
            "example": "Ticket QR issue"
          },
          "message": {
            "type": "string",
            "example": "I need help retrieving my event pass."
          }
        },
        "required": [
          "name",
          "email",
          "subject",
          "message"
        ]
      },
      "ModerateEventStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PUBLISHED",
              "CANCELLED"
            ],
            "example": "PUBLISHED"
          },
          "reason": {
            "type": "string",
            "example": "Approved after policy review"
          }
        },
        "required": [
          "status"
        ]
      },
      "ReviewKycDto": {
        "type": "object",
        "properties": {
          "approved": {
            "type": "boolean",
            "example": true
          },
          "notes": {
            "type": "string",
            "example": "Documents verified"
          }
        },
        "required": [
          "approved"
        ]
      },
      "CreateManagedUserDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateUserRoleDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "ATTENDEE",
              "ORGANIZER",
              "CHECK_IN_STAFF",
              "ADMIN"
            ]
          }
        },
        "required": [
          "role"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "CreateEventDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateEventDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PUBLISHED",
              "CANCELLED"
            ],
            "description": "Change the event status"
          }
        }
      },
      "UpdateEventStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PUBLISHED",
              "CANCELLED"
            ],
            "example": "DRAFT",
            "description": "Target status (e.g., restore CANCELLED -> DRAFT or PUBLISHED)"
          }
        },
        "required": [
          "status"
        ]
      },
      "PurchaseTicketDto": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "example": "12"
          },
          "ticketTypeId": {
            "type": "string",
            "example": "3"
          },
          "txRef": {
            "type": "string",
            "example": "TM-LX1Y2Z3-ABCD1234",
            "description": "PayChangu tx_ref of the successful payment for this ticket. Required unless PURCHASE_REQUIRES_PAYMENT=false."
          }
        },
        "required": [
          "eventId",
          "ticketTypeId"
        ]
      },
      "ValidateTicketDto": {
        "type": "object",
        "properties": {
          "qrToken": {
            "type": "string",
            "description": "The secret UUID encoded in the ticket QR code.",
            "format": "uuid"
          },
          "eventId": {
            "type": "string",
            "description": "Event being checked in, used to reject tickets for another event.",
            "example": "42"
          }
        },
        "required": [
          "qrToken"
        ]
      },
      "TicketValidationResponseDto": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean",
            "description": "Whether the ticket was accepted for entry."
          },
          "reason": {
            "type": "string",
            "enum": [
              "NOT_FOUND",
              "ALREADY_USED",
              "CANCELLED",
              "WRONG_EVENT",
              "EVENT_CANCELLED",
              "NOT_ASSIGNED"
            ],
            "nullable": true,
            "description": "Rejection reason, or null for an accepted ticket."
          },
          "ticketId": {
            "type": "string",
            "nullable": true
          },
          "eventId": {
            "type": "string",
            "nullable": true
          },
          "validatedAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "accepted",
          "reason",
          "ticketId",
          "eventId",
          "validatedAt"
        ]
      },
      "CreateTicketTypeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Early Bird"
          },
          "description": {
            "type": "string",
            "example": "Limited early access tickets."
          },
          "price": {
            "type": "number",
            "example": 25.5,
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "example": "MWK",
            "minLength": 3,
            "maxLength": 3
          },
          "quantity": {
            "type": "number",
            "example": 100,
            "minimum": 0
          },
          "perOrderLimit": {
            "type": "number",
            "example": 4,
            "minimum": 1,
            "default": 10
          },
          "salesStartAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-11-01T08:00:00.000Z"
          },
          "salesEndAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-11-15T18:00:00.000Z"
          }
        },
        "required": [
          "name",
          "price",
          "currency",
          "quantity"
        ]
      },
      "UpdateTicketTypeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Early Bird"
          },
          "description": {
            "type": "string",
            "example": "Limited early access tickets."
          },
          "price": {
            "type": "number",
            "example": 25.5,
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "example": "MWK",
            "minLength": 3,
            "maxLength": 3
          },
          "quantity": {
            "type": "number",
            "example": 100,
            "minimum": 0
          },
          "perOrderLimit": {
            "type": "number",
            "example": 4,
            "minimum": 1,
            "default": 10
          },
          "salesStartAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-11-01T08:00:00.000Z"
          },
          "salesEndAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-11-15T18:00:00.000Z"
          }
        }
      },
      "CreateOrderDto": {
        "type": "object",
        "properties": {}
      },
      "CreateStaffDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Chikondi Banda",
            "minLength": 2,
            "maxLength": 150
          },
          "email": {
            "type": "string",
            "example": "gate1.staff@example.com"
          },
          "password": {
            "type": "string",
            "description": "Initial password the staff member signs in with.",
            "minLength": 10,
            "maxLength": 72
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "AssignStaffEventsDto": {
        "type": "object",
        "properties": {
          "eventIds": {
            "description": "The complete list of your events this staff member may check tickets in for. It replaces the previous assignment; send an empty list to remove all assignments.",
            "example": [
              "42",
              "43"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "eventIds"
        ]
      },
      "SetStaffActiveDto": {
        "type": "object",
        "properties": {
          "isActive": {
            "type": "boolean",
            "description": "false disables the account (no sign-in, existing tokens stop working, no ticket validation); true re-enables it."
          }
        },
        "required": [
          "isActive"
        ]
      },
      "SubmitKycDto": {
        "type": "object",
        "properties": {
          "businessName": {
            "type": "string",
            "example": "Zomba Live Events Ltd"
          },
          "registrationNumber": {
            "type": "string",
            "example": "REG-2026-88412"
          },
          "documentType": {
            "type": "string",
            "example": "NATIONAL_ID"
          },
          "documentUrl": {
            "type": "string",
            "example": "https://example.com"
          }
        },
        "required": [
          "businessName",
          "documentType",
          "documentUrl"
        ]
      }
    }
  }
}